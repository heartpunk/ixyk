module(
    name = "ixyk",
    version = "0.0.1",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")

coverage_runtime = use_repo_rule("//.ci:coverage.bzl", "coverage_runtime")

coverage_runtime(name = "ci_coverage_runtime")

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

nix_python = use_extension("@ifrl//bazel/ixyk/tools:nix_python.bzl", "nix_python")
use_repo(nix_python, "nix_python_toolchains")

register_toolchains("@nix_python_toolchains//:all")

pip = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
)
pip.parse(
    hub_name = "ixyk_pypi",
    python_interpreter = "python3.12",
    python_version = "3.12",
    requirements_by_platform = {
        "//extractor:requirements_linux_x86_64.txt": "linux_x86_64",
    },
)

# Use the development environment's packages for every overlapping dependency.
# Pip supplies only test tools absent from that environment.
override_repo(
    pip,
    ixyk_pypi_312_angr = "shared_angr",
    ixyk_pypi_312_angr_data = "shared_angr",
    ixyk_pypi_312_archinfo = "shared_angr",
    ixyk_pypi_312_arpy = "shared_angr",
    ixyk_pypi_312_bitarray = "shared_angr",
    ixyk_pypi_312_bitstring = "shared_angr",
    ixyk_pypi_312_cachetools = "shared_angr",
    ixyk_pypi_312_capstone = "shared_angr",
    ixyk_pypi_312_cart = "shared_angr",
    ixyk_pypi_312_cffi = "shared_angr",
    ixyk_pypi_312_cle = "shared_angr",
    ixyk_pypi_312_coverage = "shared_angr",
    ixyk_pypi_312_cxxheaderparser = "shared_angr",
    ixyk_pypi_312_future = "shared_angr",
    ixyk_pypi_312_gitdb = "shared_angr",
    ixyk_pypi_312_gitpython = "shared_angr",
    ixyk_pypi_312_hypothesis = "shared_angr",
    ixyk_pypi_312_iniconfig = "shared_angr",
    ixyk_pypi_312_lmdb = "shared_angr",
    ixyk_pypi_312_markdown_it_py = "shared_angr",
    ixyk_pypi_312_mdurl = "shared_angr",
    ixyk_pypi_312_minidump = "shared_angr",
    ixyk_pypi_312_mpmath = "shared_angr",
    ixyk_pypi_312_msgspec = "shared_angr",
    ixyk_pypi_312_mulpyplexer = "shared_angr",
    ixyk_pypi_312_networkx = "shared_angr",
    ixyk_pypi_312_packaging = "shared_angr",
    ixyk_pypi_312_pefile = "shared_angr",
    ixyk_pypi_312_platformdirs = "shared_angr",
    ixyk_pypi_312_pluggy = "shared_angr",
    ixyk_pypi_312_protobuf = "shared_angr",
    ixyk_pypi_312_psutil = "shared_angr",
    ixyk_pypi_312_pycparser = "shared_angr",
    ixyk_pypi_312_pycryptodome = "shared_angr",
    ixyk_pypi_312_pydemumble = "shared_angr",
    ixyk_pypi_312_pyelftools = "shared_angr",
    ixyk_pypi_312_pygments = "shared_angr",
    ixyk_pypi_312_pypcode = "shared_angr",
    ixyk_pypi_312_pytest = "shared_angr",
    ixyk_pypi_312_pyvex = "shared_angr",
    ixyk_pypi_312_pyxbe = "shared_angr",
    ixyk_pypi_312_pyxdia = "shared_angr",
    ixyk_pypi_312_rich = "shared_angr",
    ixyk_pypi_312_smmap = "shared_angr",
    ixyk_pypi_312_sortedcontainers = "shared_angr",
    ixyk_pypi_312_sympy = "shared_angr",
    ixyk_pypi_312_typing_extensions = "shared_angr",
    ixyk_pypi_312_uefi_firmware = "shared_angr",
    ixyk_pypi_312_unicorn = "shared_angr",
    ixyk_pypi_312_z3_solver = "shared_angr",
)

use_repo(pip, "ixyk_pypi")

nix_native_deps = use_extension(
    "@ifrl//bazel/ixyk/tools:nix_native_deps.bzl",
    "nix_native_deps",
)
use_repo(nix_native_deps, "nix_native_deps")

nix_xed_repository = use_repo_rule("//tools:nix_xed.bzl", "nix_xed_repository")
nix_xed_repository(name = "nix_xed")

bazel_dep(name = "ifrl", version = "0.1.0")
git_override(
    module_name = "ifrl",
    commit = "d4fdac39e0cfe916cc6d4edcd8043ce9d08cdda4",
    remote = "https://github.com/heartpunk/ifrl.git",
)

angr_environment_repository = use_repo_rule("@ifrl//bazel/angr:repository.bzl", "angr_environment_repository")

angr_environment_repository(name = "shared_angr")
