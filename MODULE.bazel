module(
    name = "ixyk",
    version = "0.0.1",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "ixyk_vendored_arpy", version = "1.1.1")
bazel_dep(name = "ixyk_vendored_mulpyplexer", version = "0.9")

local_path_override(
    module_name = "ixyk_vendored_arpy",
    path = "third_party/arpy",
)

local_path_override(
    module_name = "ixyk_vendored_mulpyplexer",
    path = "third_party/mulpyplexer",
)

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

nix_python = use_extension("//tools:nix_python.bzl", "nix_python")
use_repo(nix_python, "nix_python_toolchains")

register_toolchains("@nix_python_toolchains//:all")

pip = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
)
pip.parse(
    hub_name = "ixyk_pypi",
    python_interpreter = "python3.12",
    python_version = "3.12",
    requirements_by_platform = {
        "//extractor:requirements_linux_x86_64.txt": "linux_x86_64",
    },
)

override_repo(
    pip,
    ixyk_pypi_312_angr = "shared_angr",
    ixyk_pypi_312_arpy = "ixyk_vendored_arpy",
    ixyk_pypi_312_mulpyplexer = "ixyk_vendored_mulpyplexer",
)

use_repo(pip, "ixyk_pypi")

nix_native_deps = use_extension(
    "//tools:nix_native_deps.bzl",
    "nix_native_deps",
)
use_repo(nix_native_deps, "nix_native_deps")

bazel_dep(name = "ifrl", version = "0.1.0")
git_override(
    module_name = "ifrl",
    remote = "https://github.com/heartpunk/ifrl.git",
    commit = "0eeb6ac73ee585ccdf746ba4f2c6e62291da930a",
)

angr_repository = use_repo_rule("@ifrl//bazel/angr:repository.bzl", "angr_repository")
angr_repository(
    name = "shared_angr",
    deps = [
        "@ixyk_pypi//angr_data:pkg",
        "@ixyk_pypi//archinfo:pkg",
        "@ixyk_pypi//pyvex:pkg",
        "@ixyk_pypi//cle:pkg",
        "@ixyk_pypi//pypcode:pkg",
        "@ixyk_pypi//capstone:pkg",
        "@ixyk_pypi//networkx:pkg",
        "@ixyk_pypi//sympy:pkg",
        "@ixyk_pypi//cachetools:pkg",
        "@ixyk_pypi//sortedcontainers:pkg",
        "@ixyk_pypi//protobuf:pkg",
        "@ixyk_pypi//psutil:pkg",
        "@ixyk_pypi//cffi:pkg",
        "@ixyk_pypi//pycparser:pkg",
        "@ixyk_pypi//rich:pkg",
        "@ixyk_pypi//gitpython:pkg",
        "@ixyk_pypi//lmdb:pkg",
        "@ixyk_pypi//mulpyplexer:pkg",
        "@ixyk_pypi//msgspec:pkg",
        "@ixyk_pypi//pydemumble:pkg",
        "@ixyk_pypi//typing_extensions:pkg",
        "@ixyk_pypi//cxxheaderparser:pkg",
        "@ixyk_pypi//platformdirs:pkg",
        "@ixyk_pypi//z3_solver:pkg",
    ],
)
