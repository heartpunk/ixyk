load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//catalog:x86_64_probes.bzl", "X86_64_PROBES")
load(":reapi_platform.bzl", "local_reapi_platform")

py_library(
    name = "xed_enc2_dispatch",
    srcs = ["xed_enc2_dispatch.py"],
)

py_test(
    name = "xed_enc2_dispatch_test",
    srcs = ["xed_enc2_dispatch_test.py"],
    deps = [":xed_enc2_dispatch"],
)

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

_GOLDEN_ARTIFACTS = [
    (
        "%d_%s.acquisition.json" % (
            rank,
            family.lower(),
        ),
        "//catalog:artifacts/%d_%s.acquisition.json" % (
            rank,
            family.lower(),
        ),
    )
    for rank, family, _assembly, _instruction_hex in X86_64_PROBES
] + [
    (
        "%d_%s.model.json.zst" % (
            rank,
            family.lower(),
        ),
        "//catalog:artifacts/%d_%s.model.json" % (
            rank,
            family.lower(),
        ),
    )
    for rank, family, _assembly, _instruction_hex in X86_64_PROBES
]

py_binary(
    name = "update_golden",
    srcs = ["golden.py"],
    args = ["--mode=update"] + [
        "--artifact=%s=$(rlocationpath %s)" % (destination, source)
        for destination, source in _GOLDEN_ARTIFACTS
    ],
    data = [source for _, source in _GOLDEN_ARTIFACTS],
    main = "golden.py",
    target_compatible_with = _LINUX_X86_64,
)

py_binary(
    name = "check_golden",
    srcs = ["golden.py"],
    args = ["--mode=check"] + [
        "--artifact=%s=$(rlocationpath %s)" % (destination, source)
        for destination, source in _GOLDEN_ARTIFACTS
    ],
    data = [source for _, source in _GOLDEN_ARTIFACTS],
    main = "golden.py",
    target_compatible_with = _LINUX_X86_64,
)

platform(
    name = "reapi_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "cpu_count": "2",
        "ghot-nix-contract": "ghot-e7a3ca80-lean118d8caf-procself-bazel9-v2",
        "memory_mb": "4096",
    },
    visibility = ["//visibility:public"],
)

local_reapi_platform()
