    name = "ret_regression_test",
    instruction_hex = "c3",  # ret
)

semantic_regression_test(
    name = "bt_regression_test",
    args = [
        "--identity-memory",
        "--skip-fuzz",
    ],
    instruction_hex = "480fa3d8",  # bt rax, rbx
)

