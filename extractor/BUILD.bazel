# Separate REAPI actions let Bazel schedule each opcode and recording mode.
[
    py_test(
        name = "concrete_baseline_" + opcode.lower() + "_" + mode.replace("-", "_") + "_test",
        size = "large",
        timeout = "eternal",
        srcs = ["evidence_baseline_test.py"],
        args = [
            "--opcode",
            opcode,
            "--recording",
            mode,
            "--samples",
            "100",
        ],
        data = ["@nix_native_deps//:libstdcxx"],
        env = {
            "GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)",
            "PYTHONNOUSERSITE": "1",
            "PYTHONSAFEPATH": "1",
        },
        main = "evidence_baseline_test.py",
        tags = ["manual"],
        target_compatible_with = _LINUX_X86_64,
        deps = [":evidence_benchmark_lib"],
    )
    for opcode in [
        "ADD",
        "MOV",
        "XCHG",
        "RET",
    ]
    for mode in [
        "off",
        "reference-json",
    ]
]

